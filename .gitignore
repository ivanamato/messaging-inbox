# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

justfile

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
*.pem
*.png

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
.env.*.local

# multi-device config (contains API keys)
devices.json

# MCP configuration
.mcp.json

# Playwright MCP artifacts (logs, screenshots)
.playwright-mcp/

# Claude Code local config
.claude

# vercel
.vercel

# Vue 3 private example app (local dev only)
examples/vue3-private-example/

# typescript
*.tsbuildinfo
next-env.d.ts

# justfile (contains push/release commands)
justfiletest-results/
playwright-report/
